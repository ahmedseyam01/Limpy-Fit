# Server-side settings for /api (set them in Vercel → Project → Settings → Environment Variables).
# For local development copy this file to .env.local (git-ignored) and fill it in.

# Long random string used to sign login tokens and encrypt stored data.
# Keep it secret and never change it after going live: data encrypted with it can't be read with another value.
AUTH_SECRET=

# Coach (admin) login.
COACH_EMAIL=coachahmed123@limbyfit.com
COACH_PASSWORD=

# Optional: a different restful-api.dev object to store data in.
# Locally, leaving it empty uses a temporary in-memory store (real data is never touched).
SYNC_STORE_URL=
